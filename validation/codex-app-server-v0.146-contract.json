    "fileChange",
    "mcpToolCall",
    "webSearch",
    "imageView",
    "computerAction",
    "dynamicToolCall",
    "collabAgentToolCall"
  ],
  "permission_profile": {
    "sandbox": "read-only",
    "approval_policy": "never",
    "mcp_enabled": false,
    "tool_event_tripwire": true
  }
